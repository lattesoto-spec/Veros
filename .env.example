DATABASE_URL=postgresql+psycopg://caremin:caremin@127.0.0.1:5433/caremin
SECRET_KEY=replace-with-a-random-local-secret
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
AUTO_INIT_DB=1
IMPORT_WORKER=thread
# Unknown layouts require a mapping provider; built-in examples work offline.
ANTHROPIC_API_KEY=
# Production only: IMPORT_WORKER=invoke, WORKER_SECRET, BLOB_READ_WRITE_TOKEN,
# and distinct Neon databases for Preview and Production.
# Production/preview: exact frontend origins allowed through the Vercel proxy.
# Separate Preview and Production values. Comma-separated, no paths/wildcards.
PUBLIC_APP_ORIGINS=
